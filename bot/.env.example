# Token del bot, lo da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# URL pública donde queda desplegado el servicio en Render (sin barra final)
# Ej: https://tren-sarmiento-bot.onrender.com
PUBLIC_URL=

# Si es "true", el bot responde preguntas "al aire" en el grupo (sin que lo
# mencionen), detectadas por palabras clave del rubro tren/AMBA + señales de
# pregunta. Si es "false" (default), solo responde cuando lo mencionan o le
# responden un mensaje.
RESPONDER_SIN_MENCION=false

# API key gratuita de Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Opcional: semáforo de estado vía Firestore (mismo proyecto del sitio) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Opcional: API Transporte oficial (dejar en false hasta confirmar que está online) ---
USE_API_TRANSPORTE=false
API_TRANSPORTE_CLIENT_ID=
API_TRANSPORTE_CLIENT_SECRET=

# Tu ID numérico de Telegram (NO el @usuario), para que el bot te avise por
# privado si detecta un insulto/agravio en el grupo. Ver README.
ADMIN_TELEGRAM_ID=

# El chat ID del grupo autorizado (Pasajeros del Tren Sarmiento). Si el bot
# es agregado a cualquier otro grupo, se va solo. Dejar vacío = sin
# restricción (no recomendado para producción).
ALLOWED_GROUP_ID=-1001532503966
